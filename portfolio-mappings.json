{
  "style1": {
    "scalar": {
      "fullName": "logo",
      "headline": "hero.title",
      "tagline": "hero.subtitle",
      "ctaText": { "path": "hero.buttonText", "keepWhenBlank": true },
      "aboutTitle": "about.title",
      "aboutText": "about.description",
      "profileImage": { "path": "about.profileImage", "keepWhenBlank": true },
      "contactTitle": { "path": "contact.title", "keepWhenBlank": true },
      "email": "contact.formEmail",
      "copyright": "footer.copyright"
    },
    "compose": {
      "about.title": { "template": "About {fullName}", "onlyIfBlank": "aboutTitle" }
    },
    "arrays": {
      "projects": {
        "targetPath": "samples",
        "itemMap": { "title": "title", "description": "description", "image": "image", "link": "link" }
      },
      "testimonials": {
        "targetPath": "testimonials",
        "itemMap": { "text": "text", "author": "author" }
      }
    },
    "objectMap": {
      "socialLinks": { "targetPath": "social", "keyFrom": "platform", "valueFrom": "url", "normalizeKey": "lowerSlug" }
    }
  },

